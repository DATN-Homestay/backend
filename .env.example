# ================================================================
# STAYAI - CẤU HÌNH KẾT NỐI AIVEN FOR MYSQL CLOUD (ONLINE DATABASE)
# ================================================================
PORT=3000
NODE_ENV=development

# Thông tin lấy trực tiếp từ Service Overview trên Dashboard Aiven:
DB_HOST=homestay-nam0072004-b252.h.aivencloud.com
DB_PORT=16896
DB_USERNAME=avnadmin
DB_PASSWORD=AVNS_EULEhrA6URi3BdcqYhi
DB_DATABASE=defaultdb

# Bật kết nối bảo mật SSL bắt buộc của Aiven
DB_SSL=true
# Đường dẫn file chứng chỉ ca.pem (tải từ Aiven Dashboard và lưu vào thư mục certs/)
DB_SSL_CA_PATH=./src/certs/ca.pem

# Tự động đồng bộ và sinh toàn bộ bảng vào DB khi khởi động NestJS
DB_SYNCHRONIZE=true

# Khóa bí mật mã hóa đối xứng AES-256 (32 bytes hex) cho CCCD và STK
AES_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# RapidAPI Booking Engine Credentials
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=booking-com15.p.rapidapi.com
CACHE_TTL_PRICE_HOURS=6

# AI Microservice URL (FastAPI)
AI_SERVICE_URL=http://localhost:8000
# CLOUDINARY 
CLOUDINARY_CLOUD_NAME=dgb1vimox
CLOUDINARY_API_KEY=137174984569314
CLOUDINARY_API_SECRET=zYPm9ckCDw0XE7rKdEcOKKI9xK4

# JWT (REQ-028) - tạo secret ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_to_a_random_secret_at_least_32_chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7

# EMAIL OTP CONFIG (Nodemailer / Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="StayAI Platform <no-reply@stayai.vn>"

# ================================================================
# VNPAY SANDBOX (TỰ ĐỘNG SINH MÃ QR & HỖ TRỢ THẺ ATM NỘI ĐỊA/VISA)
# Đăng ký tài khoản Sandbox miễn phí tại: https://sandbox.vnpayment.vn/devreg/
# Sau khi đăng ký, VNPay gửi email chứa TmnCode và HashSecret:
# ================================================================
# 1. Mã website (Terminal ID) VNPay cấp (ví dụ: CGXZNC0K)
VNP_TMN_CODE=your_vnpay_tmn_code_here

# 2. Khóa bí mật chữ ký số HMAC-SHA512 (ví dụ chuỗi 32 hoặc 64 ký tự hex)
VNP_HASH_SECRET=your_vnpay_hash_secret_here

# 3. URL cổng thanh toán VNPay Sandbox (mặc định)
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# 4. Return URL: VNPay chuyển hướng khách về backend sau khi quét mã thanh toán xong
VNP_RETURN_URL=http://localhost:3000/api/v1/vnpay/return

# 5. Frontend URL: Backend redirect khách về trang kết quả đơn hàng trên giao diện web
FRONTEND_URL=http://localhost:5173

