# ================================================================
# STAYAI - CẤU HÌNH KẾT NỐI AIVEN FOR MYSQL CLOUD (ONLINE DATABASE)
# ================================================================
PORT=3000
NODE_ENV=development

# Thông tin lấy trực tiếp từ Service Overview trên Dashboard Aiven:
DB_HOST=mysql-xxxx-your-project.aivencloud.com
DB_PORT=25060
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password_here
DB_DATABASE=defaultdb

# Bật kết nối bảo mật SSL bắt buộc của Aiven
DB_SSL=true
# Đường dẫn file chứng chỉ ca.pem (tải từ Aiven Dashboard và lưu vào thư mục certs/)
DB_SSL_CA_PATH=./certs/ca.pem

# Tự động đồng bộ và sinh toàn bộ bảng vào DB khi khởi động NestJS
DB_SYNCHRONIZE=true

# Khóa bí mật mã hóa đối xứng AES-256 (32 bytes hex) cho CCCD và STK
AES_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# RapidAPI Booking Engine Credentials
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=booking-com15.p.rapidapi.com
CACHE_TTL_PRICE_HOURS=6

# AI Microservice URL (FastAPI)
AI_SERVICE_URL=http://localhost:8000
